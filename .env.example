# Copy this file to ".env" (in this folder, or in the parent folder) and fill it in.
# .env holds secrets and is git-ignored - never commit it.

# --- Required ------------------------------------------------------------------
# TypeSafe / Jev API key (https://console.typesafe.ai/keys). TYPESAFE_API_KEY also works.
Jev_Key=
# Dograh API key - from the SAME deployment as DOGRAH_BASE_URL
DOGRAH_API_KEY=
DOGRAH_BASE_URL=https://dograh.grobots.ai/api/v1

# --- Optional (defaults shown) -------------------------------------------------
# JEV_MODEL=jev-1.14.0
# INTEREST_THRESHOLD=0.85
# ALLOWED_PHONE_REGIONS=US            # e.g. US,PR,VI,GU,MP,AS to include US territories
# SKIP_ALREADY_CALLED=true             # never re-call numbers called in earlier runs
# CALL_CONCURRENCY=1
# DECISION_CONCURRENCY=8
# QUEUE_MAXSIZE=100
# CALL_MAX_WAIT_SECONDS=900
# RESULTS_FILE=output/call_results.xlsx
